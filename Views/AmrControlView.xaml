<UserControl x:Class="NovaniX_EM2.Views.AmrControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comm="clr-namespace:NovaniX_EM2.Communication"
             Background="White"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewKeyUp="UserControl_PreviewKeyUp"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0" DataContext="{x:Static comm:SeerAmrController.Instance}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AMR 실시간 모니터링 및 맵" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Grid.Row="1" Header="AMR 주행 및 시스템 상태" Margin="0,0,0,15" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="배터리 및 상태:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <Grid Width="150">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatteryLevel, Mode=OneWay}" Height="22" Foreground="#4CAF50"/>
                            <TextBlock Text="{Binding BatteryLevel, StringFormat={}{0:F1} %}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock Text="모션 상태:" VerticalAlignment="Center" FontWeight="Bold" Margin="30,0,10,0"/>
                        <TextBlock Text="{Binding MotionStateText, FallbackValue='정지 상태'}" FontSize="14" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="현재 위치 (X, Y):" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="{Binding PosX, StringFormat=X: {0:F3} m}" MinWidth="110" Margin="0,0,15,0" FontSize="14"/>
                        <TextBlock Text="{Binding PosY, StringFormat=Y: {0:F3} m}" MinWidth="110" Margin="0,0,15,0" FontSize="14"/>
                        <TextBlock Text="{Binding PosAngle, StringFormat=Angle: {0:F1}°}" MinWidth="110" FontSize="14"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="현재 속도:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="{Binding SpeedVx, StringFormat=Vx: {0:F3} m/s}" MinWidth="110" Margin="0,0,15,0" FontSize="14" Foreground="#D84315"/>
                        <TextBlock Text="{Binding SpeedVy, StringFormat=Vy: {0:F3} m/s}" MinWidth="110" Margin="0,0,15,0" FontSize="14" Foreground="#D84315"/>
                        <TextBlock Text="{Binding SpeedW, StringFormat=W: {0:F3} rad/s}" MinWidth="110" FontSize="14" Foreground="#D84315"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="LiDAR 맵 및 스케줄링 시각화" Padding="10">
                <Grid>
                    <Border BorderBrush="DarkGray" BorderThickness="1" Background="#1E1E1E" ClipToBounds="True">
                        <Canvas x:Name="MapCanvas" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                            <TextBlock Text="맵을 클릭하여 스케줄 포인트(A, B, C...)를 추가하세요." Foreground="LightGray" Canvas.Top="10" Canvas.Left="10" FontSize="11"/>

                            <Polygon Points="{Binding LidarPoints}" Fill="#3300FF00" Stroke="#00FF00" StrokeThickness="1" Opacity="0.6"/>

                            <Polyline Points="{Binding LidarPoints}" Stroke="DodgerBlue" StrokeThickness="2" StrokeDashArray="2 2" />

                            <ItemsControl ItemsSource="{Binding WaypointQueue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding UiX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding UiY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="-10,-10,0,0">
                                            <Ellipse Width="20" Height="20" Fill="#E65100" Stroke="White" StrokeThickness="2"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Canvas.Left="{Binding PosX_UI, FallbackValue=200}" Canvas.Top="{Binding PosY_UI, FallbackValue=200}">
                                <Ellipse Width="24" Height="24" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Margin="-12,-12,0,0"/>
                                <Polygon Points="0,-4 16,0 0,4" Fill="Yellow" Margin="0,0,0,0" RenderTransformOrigin="0,0">
                                    <Polygon.RenderTransform>
                                        <RotateTransform Angle="{Binding PosAngle, FallbackValue=0}"/>
                                    </Polygon.RenderTransform>
                                </Polygon>
                            </Grid>
                        </Canvas>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                        <Button Content="스케줄 초기화" Click="BtnClearSchedule_Click" Width="90" Height="30" Background="#757575" Foreground="White" Margin="0,0,10,0"/>
                        <Button Content="주행 시작" Click="BtnStartSchedule_Click" Width="90" Height="30" Background="#1565C0" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="1" DataContext="{x:Static comm:SeerAmrController.Instance}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="AMR 상세 제어 및 모니터링" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="통신 상태" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Ellipse Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E53935"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsControlConnected}" Value="True">
                                            <Setter Property="Fill" Value="#43A047"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="IP 주소:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtAmrIp" Text="192.168.1.100" Width="120" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Button Click="BtnToggleConnect_Click" Width="120" Height="26" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Connect"/>
                                    <Setter Property="Background" Value="#E53935"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsControlConnected}" Value="True">
                                            <Setter Property="Content" Value="Disconnect"/>
                                            <Setter Property="Background" Value="#43A047"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding IsStatusConnected, StringFormat={}상태 포트(19204): {0}}" />
                        <TextBlock Text="{Binding IsControlConnected, StringFormat={}제어 포트(19205): {0}}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GroupBox Grid.Row="2" Header="경로 스케줄 진행 현황" Margin="0,0,0,15">
                <ItemsControl ItemsSource="{Binding WaypointQueue}" Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,5,10,5">
                                <TextBlock Text="{Binding Name, StringFormat={}{0}}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Status, StringFormat={}({0})}" Foreground="#1976D2" Margin="2,0,5,0"/>
                                <TextBlock Text="➔" Foreground="Gray" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <TabControl Grid.Row="3" Margin="0,0,0,15" Background="White">

                <TabItem Header="수동 이동 제어 (키보드 연동 JOG)">
                    <StackPanel Margin="10">
                        <TextBlock Text="※ 빈 곳을 한 번 클릭하면 키보드 제어가 활성화됩니다." Foreground="Gray" FontSize="11" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <ComboBox x:Name="cbDriveMode" SelectionChanged="CbDriveMode_SelectionChanged" Margin="0,0,0,15" Padding="5">
                            <ComboBoxItem Content="차동 구동 모드 (SRC-880-T)" IsSelected="True"/>
                            <ComboBoxItem Content="쌍타발 전방향 모드 (SRC-1100)"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="이동 속도(m/s):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtJogSpeed" Text="0.3" Width="50" Padding="2"/>

                            <TextBlock Text="회전 속도(rad/s):" VerticalAlignment="Center" Margin="20,0,5,0"/>
                            <TextBox x:Name="txtJogRotSpeed" Text="0.2" Width="50" Padding="2"/>
                        </StackPanel>

                        <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="65"/>
                                <RowDefinition Height="65"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnJogLeft" Grid.Row="0" Grid.Column="0" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="Left" Margin="3" Cursor="Hand" IsEnabled="False">
                                <TextBlock Text="◀&#x0a;Q" TextAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="Forward" Margin="3" Cursor="Hand">
                                <TextBlock Text="▲&#x0a;W" TextAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button x:Name="btnJogRight" Grid.Row="0" Grid.Column="2" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="Right" Margin="3" Cursor="Hand" IsEnabled="False">
                                <TextBlock Text="▶&#x0a;R" TextAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="TurnLeft" Margin="3" Cursor="Hand">
                                <TextBlock Text="↺&#x0a;A" TextAlignment="Center" FontWeight="Bold" FontSize="16"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="Backward" Margin="3" Cursor="Hand">
                                <TextBlock Text="▼&#x0a;S" TextAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="2" PreviewMouseDown="Jog_MouseDown" PreviewMouseUp="Jog_MouseUp" MouseLeave="Jog_MouseLeave" Tag="TurnRight" Margin="3" Cursor="Hand">
                                <TextBlock Text="↻&#x0a;D" TextAlignment="Center" FontWeight="Bold" FontSize="16"/>
                            </Button>
                        </Grid>

                        <Button Content="즉시 정지 (API 2000)" Click="BtnStop_Click" Height="40" Background="DarkRed" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="AMR Input / Output">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Input (DI)">
                            <ItemsControl ItemsSource="{Binding AmrInputs}" Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,7"
                                                    Visibility="{Binding IsUsed, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="18" Height="18" Margin="0,0,10,0" Stroke="Gray" StrokeThickness="1">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Fill" Value="#43A047"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Output (DO)">
                            <ItemsControl ItemsSource="{Binding AmrOutputs}" Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnToggleOutput_Click" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand" HorizontalContentAlignment="Left"
                                                Visibility="{Binding IsUsed, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="18" Height="18" Margin="0,0,10,0" Stroke="Gray" StrokeThickness="1">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#E53935"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                    <Setter Property="Fill" Value="#43A047"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="4" Text="제어 로그" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Grid.Row="5" Text="{Binding LogMessage, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#F0F0F0" Margin="0,0,0,10"/>
        </Grid>
    </Grid>
</UserControl>